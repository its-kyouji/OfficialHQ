    {
      "type": "vless", "tag": "s-vless-grpc-in", "listen": "127.0.0.1", "listen_port": 11003,
      "users": [{"uuid": "__UUID__"}],
      "transport": {"type": "grpc", "service_name": "__BASE_SVC__-s-vless-grpc"}
    }
  ]
